# IBTool Configuration File Example
# Copy this file to CONFIG.ini and modify the paths according to your setup
# Remove the # at the beginning of lines to activate settings
# Use forward slashes (/) or double backslashes (\\) in paths

[INPUT_DATA]
# Required input data files - uncomment and set paths as needed
# building_footprints_path = C:/data/buildings.shp
# road_network_path = C:/data/streets.shp
# partitions_path = C:/data/partitions.shp
# aux_layer_path = C:/data/auxiliary.shp
# filter_file_path = C:/data/filter.txt

# Example with actual test data paths:
# building_footprints_path = C:/Users/YourName/Desktop/TestData/buildings.gpkg
# road_network_path = C:/Users/YourName/Desktop/TestData/roads.gpkg
# partitions_path = C:/Users/YourName/Desktop/TestData/zones.gpkg

[PROCESSING]
# MST and spatial analysis parameters
road_length_threshold = 50.0        # Maximum length for dead-end streets (meters)
coordinate_tolerance = 0.0001       # Tolerance for coordinate comparison
buffer_distance = 5.0               # Buffer distance for intersections (meters)

# Footprint density analysis
grid_size = 100.0                   # Grid cell size for density analysis (meters)
min_building_count = 5              # Minimum buildings per grid cell
density_threshold = 0.3             # Minimum density threshold (0.0 - 1.0)

# Clustering parameters  
min_cluster_size = 3                # Minimum buildings per cluster
max_distance = 200.0                # Maximum distance between cluster members (meters)

# Coordinate system and output format
crs_epsg = 25832                    # EPSG code for coordinate reference system
output_format = gpkg                # Persisted in config; current UI writes GeoPackage output

# Settlement analysis parameters
min_overlap_blocks = 0.0            # Minimum building coverage per block (0 = auto)
global_footprint_density = 0.0      # Global footprint density threshold (0 = auto)
min_area = 0.0                      # Minimum building area filter (m²)
min_patch_size = 0.0                # Minimum settlement patch size (m²)
max_hole_size = 0.0                 # Maximum hole size to close (m²)
max_gap_size = 0.0                  # Maximum gap size to close (m²)

[OUTPUT]
# Output and workspace settings
# workspace_directory = C:/Users/YourName/ibtool_workspace
# output_directory = C:/Users/YourName/results/ibtool_result.gpkg
output_prefix = ibtool_result       # Stored in config, currently not applied by the runtime workflow
auto_save = True                    # Automatically save results
add_to_map = True                   # Add results to QGIS map
overwrite_existing = False          # Overwrite existing output files

[UI]
# User interface behavior
auto_load_last_used = True          # Load last used configuration on startup
show_progress_details = True        # Show detailed progress information
log_level = INFO                    # Logging level: CRITICAL, WARNING, INFO, SUCCESS
# log_directory =                   # Custom log directory (leave empty for default)
remember_window_size = True         # Remember dialog window size and position

# Example configuration for a complete workflow:
# 1. Uncomment and set all paths in [INPUT_DATA] section
# 2. Adjust processing parameters in [PROCESSING] section if needed
# 3. Set workspace_directory in [OUTPUT] section
# 4. Save as CONFIG.ini in the plugin root directory
# 5. Restart QGIS or reload the plugin
